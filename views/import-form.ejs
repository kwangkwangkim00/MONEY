<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '거래내역 붙여넣기' }) %>
</head>
<body>
<%- include('partials/nav', { active: 'import' }) %>

<main>
  <h1 class="page-title">거래내역 붙여넣기</h1>

  <form method="post" action="/import/preview">
    <section class="sheet">
      <p class="eyebrow">출처</p>
      <div class="field">
        <label for="sourceId">기존 출처에서 선택</label>
        <select name="sourceId" id="sourceId">
          <option value="">-- 새 출처 --</option>
          <% sources.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %></option>
          <% }) %>
        </select>
      </div>

      <fieldset>
        <legend>새 출처 (기존 출처를 선택했다면 비워두세요)</legend>
        <div class="field">
          <label for="newSourceName">이름</label>
          <input type="text" name="newSourceName" id="newSourceName" placeholder="예: 국민카드">
        </div>
        <div class="field">
          <label for="newSourceType">종류</label>
          <select name="newSourceType" id="newSourceType">
            <option value="card">카드</option>
            <option value="account">계좌</option>
          </select>
        </div>
      </fieldset>
    </section>

    <section class="sheet">
      <p class="eyebrow">거래내역</p>
      <label class="checkbox-row">
        <input type="checkbox" name="hasHeader" checked>
        첫 줄은 헤더
      </label>
      <textarea name="pastedText" placeholder="엑셀에서 복사한 내용을 여기에 붙여넣으세요"></textarea>
    </section>

    <div class="actions">
      <button type="submit">미리보기</button>
    </div>
  </form>
</main>
</body>
</html>
