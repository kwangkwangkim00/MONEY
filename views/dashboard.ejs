<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '대시보드' }) %>
</head>
<body>
<%- include('partials/nav', { active: 'dashboard' }) %>

<main>
  <h1 class="page-title"><%= month %> 요약</h1>

  <div class="month-row">
    <form method="get">
      <input type="month" name="month" value="<%= month %>" onchange="this.form.submit()">
    </form>
  </div>

  <section class="sheet">
    <div class="total-row">
      <div class="stamp">
        <span class="stamp-label">총액</span>
        <span class="stamp-amount tabular" data-count="<%= total %>"><%= total.toLocaleString() %>원</span>
      </div>
      <div class="by-source">
        <p class="eyebrow">출처별</p>
        <% if (bySource.length === 0) { %>
          <p class="empty-note">이번 달 거래내역이 없어요.</p>
        <% } %>
        <% bySource.forEach(([name, amount]) => { %>
          <div class="ledger-row">
            <span class="name"><%= name %></span>
            <span class="fill"></span>
            <span class="amount tabular" data-count="<%= amount %>"><%= amount.toLocaleString() %>원</span>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="sheet">
    <p class="eyebrow">거래내역</p>
    <% if (transactions.length === 0) { %>
      <p class="empty-note">
        아직 이번 달 거래내역이 없어요.
        <a href="/import">거래내역을 붙여넣어</a> 시작해보세요.
      </p>
    <% } else { %>
      <div class="table-scroll">
        <table class="ledger">
          <tr><th>날짜</th><th>출처</th><th>내용</th><th class="amount">금액</th></tr>
          <% transactions.forEach(t => { %>
            <tr>
              <td class="tabular"><%= t.date %></td>
              <td><%= t.source_name %></td>
              <td><%= t.description %></td>
              <td class="amount tabular"><%= t.amount.toLocaleString() %></td>
            </tr>
          <% }) %>
        </table>
      </div>
    <% } %>
  </section>

  <% if (recent.length > 0) { %>
    <section class="sheet">
      <p class="eyebrow">최근 추이</p>
      <div class="chart-wrap">
        <canvas id="trend" height="90"></canvas>
      </div>
    </section>
  <% } %>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
<script>
  const recent = <%- JSON.stringify(recent) %>;
  const canvas = document.getElementById('trend');
  if (canvas) {
    new Chart(canvas, {
      type: 'bar',
      data: {
        labels: recent.map(r => r.month),
        datasets: [{
          label: '월별 총액',
          data: recent.map(r => r.total),
          backgroundColor: '#b23a2e',
          borderRadius: 3,
          maxBarThickness: 40,
        }],
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          y: { ticks: { color: '#55665b' }, grid: { color: '#d7e2cf' } },
          x: { ticks: { color: '#55665b' }, grid: { display: false } },
        },
      },
    });
  }
</script>
<script type="module">
  // 총액이 실제로 "세어지는" 느낌을 주는 카운트업 — 숫자 자체를 애니메이션하는 건
  // CSS로는 안 되기 때문에 motion.dev를 씀. 실패해도 이미 최종 숫자가 그려져 있어
  // 화면이 깨지지 않음 (progressive enhancement).
  try {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const { animate } = await import('https://cdn.jsdelivr.net/npm/motion@13.1.1/+esm');
      document.querySelectorAll('[data-count]').forEach((el, i) => {
        const target = Number(el.dataset.count);
        const suffix = el.textContent.replace(/[\d,]/g, '');
        animate(0, target, {
          duration: 0.7,
          delay: i === 0 ? 0.15 : 0.25 + i * 0.05,
          ease: 'circOut',
          onUpdate: (latest) => {
            el.textContent = Math.round(latest).toLocaleString() + suffix;
          },
        });
      });
    }
  } catch (e) {
    // motion.dev 로드 실패해도 서버가 그려준 최종 값이 이미 표시돼 있음
  }
</script>
</body>
</html>
