<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '붙여넣기 미리보기' }) %>
</head>
<body>
<%- include('partials/nav', { active: 'import' }) %>

<main>
  <h1 class="page-title">미리보기</h1>
  <p class="empty-note">상위 <%= grid.length %>행. 각 열이 무엇을 뜻하는지 지정해주세요.</p>

  <form method="post" action="/import/save">
    <input type="hidden" name="sourceId" value="<%= sourceId %>">
    <input type="hidden" name="pastedText" value="<%= pastedText %>">
    <% if (hasHeader) { %><input type="hidden" name="hasHeader" value="on"><% } %>

    <section class="sheet">
      <div class="table-scroll">
        <table class="ledger">
          <tr>
            <% for (let c = 0; c < columnCount; c++) { %>
              <th>
                <select name="col<%= c %>">
                  <% ['ignore','date','description','amount'].forEach(role => { %>
                    <option value="<%= role %>" <%= (savedMapping && savedMapping[c] === role) ? 'selected' : '' %>><%= role %></option>
                  <% }) %>
                </select>
              </th>
            <% } %>
          </tr>
          <% grid.forEach(row => { %>
            <tr><% row.forEach(cell => { %><td><%= cell %></td><% }) %></tr>
          <% }) %>
        </table>
      </div>
    </section>

    <div class="actions">
      <button type="submit">저장</button>
    </div>
  </form>
</main>
<script>
  document.querySelector('form').addEventListener('submit', function (e) {
    const btn = e.target.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = '저장 중…';
  });
</script>
</body>
</html>
